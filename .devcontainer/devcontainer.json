{
    "name": "EcoWater Cloud Development",
    "image": "mcr.microsoft.com/devcontainers/python:3.14",
    "containerEnv": {
        // Keep the Linux venv out of the bind-mounted workspace so it does not
        // overwrite a .venv created on the host.
        "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
        "UV_CACHE_DIR": "/home/vscode/uv-cache",
        // The cache and venv are separate volumes, so uv cannot hardlink between them.
        "UV_LINK_MODE": "copy"
    },
    // Docker initializes named volumes as root.
    "onCreateCommand": "sudo chown vscode:vscode /home/vscode/.venv /home/vscode/uv-cache",
    "postCreateCommand": "pip install --user uv==0.12.2 && uv sync --frozen --extra dev",
    "forwardPorts": [8123],
    "portsAttributes": {
        "8123": {
            "label": "Home Assistant",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.mypy-type-checker",
                "charliermarsh.ruff",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll.ruff": "explicit",
                        "source.organizeImports.ruff": "explicit"
                    }
                }
            }
        }
    },
    "mounts": [
        // Named volumes survive container rebuilds. Mounted directly under $HOME
        // so Docker does not create ~/.cache as root.
        "source=${localWorkspaceFolderBasename}_venv,target=/home/vscode/.venv,type=volume",
        "source=${localWorkspaceFolderBasename}_uv_cache,target=/home/vscode/uv-cache,type=volume"
    ],
    "remoteUser": "vscode"
}
