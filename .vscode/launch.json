{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Home Assistant",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            "args": ["--config", "${workspaceFolder}/config", "--debug"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            // Home Assistant installs requirements by running `python -m uv`. Debugging
            // that child process makes the install exit 0 without installing anything.
            "subProcess": false,
            "preLaunchTask": "Stop Home Assistant"
        }
    ]
}
